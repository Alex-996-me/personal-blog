---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import { siteConfig, topicMatrix } from "../data/site";
import {
  formatDate,
  getAllInspirations,
  getAllMoments,
  getAllPosts,
  getAllResources,
  getCategoryCounts,
  getInspirationDetailHref,
  getMomentHref,
  getMomentLocation,
  getPostHref,
  getUpdatedDate,
} from "../lib/blog";
import { withBasePath } from "../lib/paths";

const [posts, inspirations, resources, moments] = await Promise.all([
  getAllPosts(),
  getAllInspirations(),
  getAllResources(),
  getAllMoments(),
]);

const latestPosts = posts.slice(0, 3);
const renderedInspirations = await Promise.all(
  inspirations.map(async (inspiration) => {
    const { Content } = await render(inspiration);
    const length = inspiration.body.replace(/[#>*_`\[\]()-]/g, "").trim().length;
    return { inspiration, Content, length };
  }),
);
const initialIdea = renderedInspirations[0];
const recentMoments = moments.slice(0, 3).map((moment) => ({
  moment,
  location: getMomentLocation(moment),
  image: moment.data.items[0]?.image ?? moment.data.images[0] ?? "",
}));
const categoryCounts = getCategoryCounts(posts, { includeHidden: false });
const topicTiles = topicMatrix.map((topic) => ({
  ...topic,
  count: topic.slug === "resources"
    ? resources.length
    : (categoryCounts.find((category) => category.slug === topic.slug)?.count ?? 0),
}));
---

<BaseLayout showSidebar={false} wideContent={true} bodyClass="body--hub-home" shellClass="page-shell--hub-home" panelClass="content-panel--hub-home">
  <div class="home-story">
    <section class="home-identity" aria-labelledby="home-identity-title" data-home-hero>
      <div class="home-identity__mark" aria-hidden="true" data-hero-ghost>N=1</div>
      <div class="home-identity__copy" data-hero-headline>
        <p class="home-section-heading__eyebrow">PERSONAL KNOWLEDGE BASE / EST. 2026</p>
        <h1 id="home-identity-title">{siteConfig.title}</h1>
        <p>{siteConfig.tagline}</p>
      </div>
      <p class="home-identity__note" data-hero-description>文章、短思想、生活记录与长期实验，在这里慢慢连接。</p>
    </section>

    {initialIdea && (
      <section class="living-ideas" aria-labelledby="home-notes-title" data-motion-section="ideas">
        <div class="home-section-heading">
          <div>
            <p class="home-section-heading__eyebrow">01 / LIVING IDEA STREAM</p>
            <h2 id="home-notes-title">精选灵感</h2>
          </div>
          <a href={withBasePath("/daily/")}>Explore Notes <span aria-hidden="true">→</span></a>
        </div>

        <article class="living-idea" data-living-idea tabindex="0" aria-label="灵感轮播，使用左右方向键切换">
          <div class="living-idea__topline">
            <span>IDEA</span>
            <time data-idea-date datetime={initialIdea.inspiration.data.date.toISOString()}>{formatDate(initialIdea.inspiration.data.date)}</time>
            <span data-idea-count>01 / {String(renderedInspirations.length).padStart(2, "0")}</span>
          </div>
          <div class="living-idea__content" data-idea-content>
            <h3 data-idea-title>{initialIdea.inspiration.data.title}</h3>
            <div class="living-idea__body prose prose--inspiration" data-idea-body><initialIdea.Content /></div>
          </div>
          <div class="living-idea__footer">
            <div class="living-idea__controls" aria-label="切换灵感">
              <button type="button" data-idea-previous aria-label="上一条灵感">←</button>
              <button type="button" data-idea-next aria-label="下一条灵感">→</button>
            </div>
            <a data-idea-link href={withBasePath(getInspirationDetailHref(initialIdea.inspiration))}>Read note →</a>
            <p class="living-idea__preview"><span>Next</span><strong data-idea-preview>{renderedInspirations[1]?.inspiration.data.title ?? initialIdea.inspiration.data.title}</strong></p>
          </div>
          <div class="living-idea__progress" aria-hidden="true"><span data-idea-progress></span></div>
        </article>

        <div class="living-idea-data" hidden aria-hidden="true">
          {renderedInspirations.map(({ inspiration, Content, length }) => (
            <template
              data-idea-template
              data-title={inspiration.data.title}
              data-date={formatDate(inspiration.data.date)}
              data-datetime={inspiration.data.date.toISOString()}
              data-href={withBasePath(getInspirationDetailHref(inspiration))}
              data-length={length}
            ><div><Content /></div></template>
          ))}
        </div>
      </section>
    )}

    {recentMoments.length > 0 && (
      <section class="home-moments" aria-labelledby="home-moments-title" data-motion-section="moments">
        <div class="home-section-heading">
          <div>
            <p class="home-section-heading__eyebrow">02 / MOMENTS</p>
            <h2 id="home-moments-title">Recent Moments</h2>
          </div>
          <a href={withBasePath("/moments/")}>Explore Moments <span aria-hidden="true">→</span></a>
        </div>

        <div class="home-moments__grid">
          {recentMoments.map(({ moment, image, location }, index) => (
            <a class="home-moment" href={withBasePath(getMomentHref(moment))}>
              <div class="home-moment__media">
                {image ? <img src={withBasePath(image)} alt={moment.data.title} loading={index === 0 ? "eager" : "lazy"} decoding="async" /> : <div class="home-moment__fallback" aria-hidden="true"></div>}
              </div>
              <div>
                <span>{location?.city ?? "MOMENT"}</span>
                <h3>{moment.data.title}</h3>
                {moment.data.description && <p>{moment.data.description}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="home-journal" aria-labelledby="home-journal-title" data-motion-section="writing">
      <div class="home-section-heading">
        <div>
          <p class="home-section-heading__eyebrow">03 / WRITING</p>
          <h2 id="home-journal-title">Recent Writing</h2>
        </div>
        <a href={withBasePath("/articles/")}>All Writing <span aria-hidden="true">→</span></a>
      </div>

      <div class="home-journal__grid">
        {latestPosts.map((post, index) => (
          <a class:list={["home-journal__story", index === 0 && "home-journal__story--lead"]} href={withBasePath(getPostHref(post))}>
            <div class="home-journal__media">
              {post.data.cover ? (
                <img src={withBasePath(post.data.cover)} alt={post.data.title} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              ) : (
                <div class="home-journal__fallback" aria-hidden="true"><span>{post.data.category}</span><strong>{post.data.title}</strong></div>
              )}
              <span class="home-journal__index">0{index + 1}</span>
            </div>
            <div class="home-journal__meta"><span>{post.data.category}</span><span>更新于 {formatDate(getUpdatedDate(post))}</span></div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="home-topics" aria-labelledby="home-topics-title" data-motion-section="topics">
      <div class="home-section-heading">
        <div><p class="home-section-heading__eyebrow">04 / TOPIC MATRIX</p><h2 id="home-topics-title">主题索引</h2></div>
      </div>
      <CategoryGrid topics={topicTiles} />
    </section>

    <section class="home-about" id="about" aria-labelledby="home-about-title" data-motion-section="about">
      <div class="home-section-heading">
        <div><p class="home-section-heading__eyebrow">05 / ABOUT</p><h2 id="home-about-title">海粟</h2></div>
        <a href={withBasePath("/about/")}>About <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-about__layout">
        <div class="home-about__portrait">
          <img src={withBasePath(siteConfig.author.portrait)} alt={`${siteConfig.author.name} 的照片`} loading="lazy" decoding="async" />
          <span>N=1 / 个人研究档案</span>
        </div>
        <div class="home-about__copy">
          <p class="home-about__lead">{siteConfig.author.shortBio}</p>
          <p>{siteConfig.author.bio}</p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const hero = document.querySelector("[data-home-hero]");
      let heroFrame = 0;
      const updateHero = () => {
        heroFrame = 0;
        if (!hero || reduceMotion.matches) return;
        const progress = Math.min(1, Math.max(0, window.scrollY / Math.max(360, hero.offsetHeight)));
        hero.style.setProperty("--hero-ghost-y", `${progress * 16}px`);
        hero.style.setProperty("--hero-title-y", `${progress * -8}px`);
        hero.style.setProperty("--hero-copy-y", `${progress * -4}px`);
        hero.style.setProperty("--hero-copy-opacity", String(1 - progress * 0.12));
      };
      const onScroll = () => {
        if (!heroFrame) heroFrame = requestAnimationFrame(updateHero);
      };
      updateHero();
      window.addEventListener("scroll", onScroll, { passive: true });

      const sections = [...document.querySelectorAll("[data-motion-section]")];
      if (reduceMotion.matches || !("IntersectionObserver" in window)) {
        sections.forEach((section) => section.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
        sections.forEach((section) => observer.observe(section));
      }

      const stream = document.querySelector("[data-living-idea]");
      const templates = [...document.querySelectorAll("[data-idea-template]")];
      if (!stream || templates.length === 0) return;

      const title = stream.querySelector("[data-idea-title]");
      const body = stream.querySelector("[data-idea-body]");
      const content = stream.querySelector("[data-idea-content]");
      const date = stream.querySelector("[data-idea-date]");
      const count = stream.querySelector("[data-idea-count]");
      const link = stream.querySelector("[data-idea-link]");
      const preview = stream.querySelector("[data-idea-preview]");
      const progress = stream.querySelector("[data-idea-progress]");
      const storageKey = "n1-living-idea-state-v1";
      const daySeed = Math.floor(Date.now() / 86400000) % templates.length;
      let index = daySeed;
      let elapsed = 0;
      let lastTime = performance.now();
      let switching = false;
      let queuedSwitch = null;
      let touchStart = null;
      const pauseReasons = new Set(reduceMotion.matches ? ["reduced-motion"] : []);
      const setPaused = (reason, value) => {
        if (value) pauseReasons.add(reason);
        else pauseReasons.delete(reason);
      };

      try {
        const saved = JSON.parse(sessionStorage.getItem(storageKey) || "null");
        if (saved && Number.isInteger(saved.index)) {
          index = ((saved.index % templates.length) + templates.length) % templates.length;
          elapsed = Math.max(0, Number(saved.elapsed) || 0);
        }
      } catch {}

      const durationFor = (item) => Math.min(11000, Math.max(7000, 6500 + Number(item.dataset.length || 80) * 19));
      const save = () => {
        try { sessionStorage.setItem(storageKey, JSON.stringify({ index, elapsed })); } catch {}
      };
      const applyIdea = (nextIndex) => {
        const item = templates[nextIndex];
        const next = templates[(nextIndex + 1) % templates.length];
        title.textContent = item.dataset.title || "";
        body.innerHTML = item.content.firstElementChild?.innerHTML || "";
        date.textContent = item.dataset.date || "";
        date.setAttribute("datetime", item.dataset.datetime || "");
        count.textContent = `${String(nextIndex + 1).padStart(2, "0")} / ${String(templates.length).padStart(2, "0")}`;
        link.setAttribute("href", item.dataset.href || "#");
        preview.textContent = next.dataset.title || "";
      };
      const show = async (nextIndex, direction = 1) => {
        if (switching) {
          queuedSwitch = { index: nextIndex, direction };
          return;
        }
        if (nextIndex === index) return;
        switching = true;
        const oldHeight = stream.getBoundingClientRect().height;
        if (!reduceMotion.matches) {
          await content.animate([
            { opacity: 1, transform: "translateY(0)" },
            { opacity: 0, transform: `translateY(${direction > 0 ? -10 : 10}px)` },
          ], { duration: 180, easing: "cubic-bezier(.4,0,1,1)", fill: "forwards" }).finished.catch(() => {});
        }
        index = ((nextIndex % templates.length) + templates.length) % templates.length;
        elapsed = 0;
        applyIdea(index);
        const newHeight = stream.getBoundingClientRect().height;
        if (!reduceMotion.matches) {
          stream.animate([
            { transform: `scaleY(${Math.max(0.82, oldHeight / Math.max(1, newHeight))})` },
            { transform: "scaleY(1)" },
          ], { duration: 420, easing: "cubic-bezier(.16,1,.3,1)" });
          content.animate([
            { opacity: 0, transform: `translateY(${direction > 0 ? 14 : -14}px) scale(.995)` },
            { opacity: 1, transform: "translateY(0) scale(1)" },
          ], { duration: 360, easing: "cubic-bezier(.16,1,.3,1)", fill: "both" });
        }
        const queued = queuedSwitch;
        queuedSwitch = null;
        switching = false;
        save();
        if (queued) void show(queued.index, queued.direction);
      };
      applyIdea(index);

      const tick = (now) => {
        const delta = Math.min(100, now - lastTime);
        lastTime = now;
        if (pauseReasons.size === 0 && !document.hidden && !switching) elapsed += delta;
        const duration = durationFor(templates[index]);
        progress.style.transform = `scaleX(${Math.min(1, elapsed / duration)})`;
        if (elapsed >= duration) void show(index + 1, 1);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      stream.querySelector("[data-idea-next]")?.addEventListener("click", () => void show(index + 1, 1));
      stream.querySelector("[data-idea-previous]")?.addEventListener("click", () => void show(index - 1, -1));
      stream.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight") { event.preventDefault(); void show(index + 1, 1); }
        if (event.key === "ArrowLeft") { event.preventDefault(); void show(index - 1, -1); }
      });
      stream.addEventListener("pointerenter", () => setPaused("hover", true));
      stream.addEventListener("pointerleave", () => setPaused("hover", false));
      stream.addEventListener("focusin", () => setPaused("focus", true));
      stream.addEventListener("focusout", () => setPaused("focus", false));
      stream.addEventListener("touchstart", (event) => {
        const touch = event.touches[0];
        touchStart = touch ? { x: touch.clientX, y: touch.clientY } : null;
        setPaused("touch", true);
      }, { passive: true });
      stream.addEventListener("touchend", (event) => {
        const touch = event.changedTouches[0];
        if (touch && touchStart) {
          const x = touch.clientX - touchStart.x;
          const y = touch.clientY - touchStart.y;
          if (Math.abs(x) > 44 && Math.abs(x) > Math.abs(y) * 1.25) void show(index + (x < 0 ? 1 : -1), x < 0 ? 1 : -1);
        }
        touchStart = null;
        setPaused("touch", false);
      }, { passive: true });
      document.addEventListener("selectionchange", () => {
        const selection = document.getSelection();
        setPaused("selection", Boolean(selection && !selection.isCollapsed && stream.contains(selection.anchorNode)));
      });
      reduceMotion.addEventListener("change", (event) => setPaused("reduced-motion", event.matches));
      document.addEventListener("visibilitychange", () => {
        setPaused("hidden", document.hidden);
        lastTime = performance.now();
        save();
      });
      window.addEventListener("pagehide", save);
    })();
  </script>
</BaseLayout>
