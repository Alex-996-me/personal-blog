---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import { siteConfig, topicMatrix } from "../data/site";
import {
  formatDate,
  getAllInspirations,
  getAllMoments,
  getAllPosts,
  getAllResources,
  getCategoryCounts,
  getInspirationDetailHref,
  getMomentHref,
  getMomentLocation,
  getPostHref,
  getUpdatedDate,
} from "../lib/blog";
import { withBasePath } from "../lib/paths";

const [posts, inspirations, resources, moments] = await Promise.all([
  getAllPosts(),
  getAllInspirations(),
  getAllResources(),
  getAllMoments(),
]);

const latestPosts = posts.slice(0, 3);
const selectedInspirations = await Promise.all(
  inspirations.slice(0, 4).map(async (inspiration) => {
    const { Content } = await render(inspiration);
    return { inspiration, Content };
  }),
);
const recentMoments = moments.slice(0, 3).map((moment) => ({
  moment,
  location: getMomentLocation(moment),
  image: moment.data.items[0]?.image ?? moment.data.images[0] ?? "",
}));
const categoryCounts = getCategoryCounts(posts, { includeHidden: false });
const topicTiles = topicMatrix.map((topic) => ({
  ...topic,
  count: topic.slug === "resources"
    ? resources.length
    : (categoryCounts.find((category) => category.slug === topic.slug)?.count ?? 0),
}));
---

<BaseLayout showSidebar={false} wideContent={true} bodyClass="body--hub-home" shellClass="page-shell--hub-home" panelClass="content-panel--hub-home">
  <div class="home-story">
    <section class="home-identity" aria-labelledby="home-identity-title">
      <div class="home-identity__mark" aria-hidden="true">N=1</div>
      <div class="home-identity__copy">
        <p class="home-section-heading__eyebrow">PERSONAL KNOWLEDGE BASE / EST. 2026</p>
        <h1 id="home-identity-title">{siteConfig.title}</h1>
        <p>{siteConfig.tagline}</p>
      </div>
      <p class="home-identity__note">文章、短思想、生活记录与长期实验，在这里慢慢连接。</p>
    </section>

    <section class="home-notes" aria-labelledby="home-notes-title">
      <div class="home-section-heading" data-reveal>
        <div>
          <p class="home-section-heading__eyebrow">01 / IDEAS</p>
          <h2 id="home-notes-title">精选灵感</h2>
        </div>
        <a href={withBasePath("/daily/")}>Explore Notes →</a>
      </div>

      <div class="home-notes__grid">
        {selectedInspirations.map(({ inspiration, Content }, index) => (
          <a class="home-note" href={withBasePath(getInspirationDetailHref(inspiration))} data-reveal data-reveal-delay={index + 1}>
            <span class="home-note__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{inspiration.data.title}</h3>
            <div class="home-note__body prose prose--inspiration"><Content /></div>
          </a>
        ))}
      </div>
    </section>

    {recentMoments.length > 0 && (
      <section class="home-moments" aria-labelledby="home-moments-title">
        <div class="home-section-heading" data-reveal>
          <div>
            <p class="home-section-heading__eyebrow">02 / MOMENTS</p>
            <h2 id="home-moments-title">Recent Moments</h2>
          </div>
          <a href={withBasePath("/moments/")}>Explore Moments →</a>
        </div>

        <div class="home-moments__grid">
          {recentMoments.map(({ moment, image, location }, index) => (
            <a class="home-moment" href={withBasePath(getMomentHref(moment))} data-reveal data-reveal-delay={index + 1}>
              {image ? <img src={withBasePath(image)} alt={moment.data.title} loading={index === 0 ? "eager" : "lazy"} decoding="async" /> : <div class="home-moment__fallback" aria-hidden="true"></div>}
              <div>
                <span>{location?.city ?? "MOMENT"}</span>
                <h3>{moment.data.title}</h3>
                {moment.data.description && <p>{moment.data.description}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="home-journal" aria-labelledby="home-journal-title">
      <div class="home-section-heading" data-reveal>
        <div>
          <p class="home-section-heading__eyebrow">03 / WRITING</p>
          <h2 id="home-journal-title">Recent Writing</h2>
        </div>
        <a href={withBasePath("/articles/")}>All Writing →</a>
      </div>

      <div class="home-journal__grid">
        {latestPosts.map((post, index) => (
          <a class:list={["home-journal__story", index === 0 && "home-journal__story--lead"]} href={withBasePath(getPostHref(post))} data-reveal data-reveal-delay={index + 1}>
            <div class="home-journal__media">
              {post.data.cover ? (
                <img src={withBasePath(post.data.cover)} alt={post.data.title} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              ) : (
                <div class="home-journal__fallback" aria-hidden="true"><span>{post.data.category}</span><strong>{post.data.title}</strong></div>
              )}
              <span class="home-journal__index">0{index + 1}</span>
            </div>
            <div class="home-journal__meta"><span>{post.data.category}</span><span>更新于 {formatDate(getUpdatedDate(post))}</span></div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="home-topics" aria-labelledby="home-topics-title">
      <div class="home-section-heading" data-reveal>
        <div><p class="home-section-heading__eyebrow">04 / TOPIC MATRIX</p><h2 id="home-topics-title">主题索引</h2></div>
      </div>
      <CategoryGrid topics={topicTiles} />
    </section>

    <section class="home-about" id="about" aria-labelledby="home-about-title">
      <div class="home-section-heading" data-reveal>
        <div><p class="home-section-heading__eyebrow">05 / ABOUT</p><h2 id="home-about-title">海粟</h2></div>
        <a href={withBasePath("/about/")}>About →</a>
      </div>
      <div class="home-about__layout">
        <div class="home-about__portrait" data-reveal>
          <img src={withBasePath(siteConfig.author.portrait)} alt={`${siteConfig.author.name} 的照片`} loading="lazy" decoding="async" />
          <span>N=1 / 个人研究档案</span>
        </div>
        <div class="home-about__copy" data-reveal data-reveal-delay="1">
          <p class="home-about__lead">{siteConfig.author.shortBio}</p>
          <p>{siteConfig.author.bio}</p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    const revealItems = Array.from(document.querySelectorAll("[data-reveal]"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.body.classList.add("reveal-ready");
    if (reducedMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -5% 0px" });
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
