---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleVisual from "../components/ArticleVisual.astro";
import LifePhoto from "../components/LifePhoto.astro";
import { siteConfig } from "../data/site";
import {
  getAllMoments,
  getAllPosts,
  getMomentHref,
  getMomentLocation,
  getHomepageWriting,
  getMomentDate,
} from "../lib/blog";
import { withBasePath } from "../lib/paths";

const [posts, moments] = await Promise.all([getAllPosts(), getAllMoments()]);
const selectedPosts = getHomepageWriting(posts, 3);
const recentMoments = moments.slice(0, 3).map((moment) => ({
  moment,
  location: getMomentLocation(moment),
  image: moment.data.items[0]?.image ?? moment.data.images[0] ?? "",
}));
---

<BaseLayout wideContent={true} bodyClass="body--hub-home" shellClass="page-shell--hub-home" panelClass="content-panel--hub-home">
  <div class="home-story">
    <section class="home-identity" aria-labelledby="home-identity-title">
      <h1 id="home-identity-title">{siteConfig.title}</h1>
      <p class="home-identity__tagline">{siteConfig.tagline}</p>
      <p class="home-identity__note">一个人的长期实验。从生活与实践中形成判断，留下经过选择的文章与日常。</p>
    </section>

    <section class="home-journal" aria-labelledby="home-journal-title">
      <div class="home-section-heading">
        <h2 id="home-journal-title">精选文章</h2>
        <a href={withBasePath("/articles/")}>所有文章</a>
      </div>
      {selectedPosts.length > 0 && (
        <div class="essay-index">{selectedPosts.map((post) => <ArticleVisual post={post} />)}</div>
      )}
    </section>

    {recentMoments.length > 0 && (
      <section class="home-moments" aria-labelledby="home-moments-title">
        <div class="home-section-heading">
          <h2 id="home-moments-title">生活</h2>
          <a href={withBasePath("/moments/")}>所有记录</a>
        </div>
        <div class="home-moments__grid">
          {recentMoments.map(({ moment, image, location }) => (
            <a class="home-moment" href={withBasePath(getMomentHref(moment))} aria-label={moment.data.title || `${getMomentDate(moment).toISOString().slice(0, 10)} 的照片`}>
              <div class="home-moment__media">
                {image && <LifePhoto src={image} alt="" sizes="(max-width: 760px) calc(100vw - 40px), 300px" />}
              </div>
              <div>{moment.data.title && <h3>{moment.data.title}</h3>}<span>{location?.city}</span></div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

</BaseLayout>
