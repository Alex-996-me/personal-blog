---
import { getCollection } from 'astro:content';
import RetiredContent from '../../components/RetiredContent.astro';
import { getInspirationSlug } from '../../lib/blog';

export async function getStaticPaths() {
  const entries = await getCollection('inspirations', ({ data }) => data.status === 'archive' && data.published !== false);
  return entries.map((entry) => ({ params: { slug: getInspirationSlug(entry) } }));
}
---

<RetiredContent />
