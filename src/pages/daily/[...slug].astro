---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import {
  formatDate,
  getAllInspirations,
  getAllPosts,
  getRelatedIdeasForInspiration,
  getRelatedWritingForInspiration,
  getInspirationDetailHref,
  getInspirationSlug,
  getInspirationUpdatedDate,
  getPostHref,
  getSources,
} from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

export async function getStaticPaths() {
  const inspirations = await getAllInspirations();
  return inspirations
    .filter((inspiration) => inspiration.data.published !== false)
    .map((inspiration) => ({
    params: { slug: getInspirationSlug(inspiration) },
    props: { inspiration },
    }));
}

const { inspiration } = Astro.props;
const { Content } = await render(inspiration);
const updated = getInspirationUpdatedDate(inspiration);
const [allInspirations, allPosts] = await Promise.all([getAllInspirations(), getAllPosts()]);
const relatedWriting = getRelatedWritingForInspiration(inspiration, allPosts);
const relatedIdeas = getRelatedIdeasForInspiration(inspiration, allInspirations);
const continueReading = [
  ...relatedWriting.map((entry) => ({ href: withBasePath(getPostHref(entry)), title: entry.data.title, meta: entry.data.category })),
  ...relatedIdeas.map((entry) => ({ href: withBasePath(getInspirationDetailHref(entry)), title: entry.data.title, meta: "灵感" })),
].slice(0, 3);
const sources = getSources(inspiration.data.source);
---

<BaseLayout
  title={inspiration.data.title}
  description={inspiration.data.description}
  wideContent={true}
  bodyClass="body--daily"
  shellClass="page-shell--daily"
  panelClass="content-panel--daily"
  searchType="IDEA"
  searchSection="灵感"
>
  <article>
    <a class="post-backlink" href={withBasePath("/daily/")}>← 返回灵感</a>

    <header class="post-header">
      <h1>{inspiration.data.title}</h1>
      <div class="post-meta">
        <span>{formatDate(inspiration.data.date)}</span>
        {updated.valueOf() !== inspiration.data.date.valueOf() && <span>更新于 {formatDate(updated)}</span>}
      </div>
    </header>

    <div class="prose prose--inspiration">
      <Content />
    </div>

    {sources.length > 0 && (
      <section class="content-sources" aria-labelledby="idea-sources-title">
        <h2 id="idea-sources-title">参考</h2>
        <ul>
          {sources.map((source) => (
            <li>
              {/^https?:\/\//i.test(source)
                ? <a href={source} target="_blank" rel="noopener noreferrer">{source}</a>
                : <span>{source}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <RelatedContent items={continueReading} />
  </article>
</BaseLayout>
