---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import {
  formatDate,
  getAllInspirations,
  getAllPosts,
  getInspirationSlug,
  getInspirationThemeHref,
  getInspirationUpdatedDate,
  getPostHref,
  getSources,
  resolveRelatedPosts,
} from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

export async function getStaticPaths() {
  const inspirations = await getAllInspirations();
  return inspirations
    .filter((inspiration) => inspiration.data.published !== false)
    .map((inspiration) => ({
    params: { slug: getInspirationSlug(inspiration) },
    props: { inspiration },
    }));
}

const { inspiration } = Astro.props;
const { Content } = await render(inspiration);
const updated = getInspirationUpdatedDate(inspiration);
const relatedWriting = resolveRelatedPosts(inspiration.data.relatedPosts, await getAllPosts());
const sources = getSources(inspiration.data.source);
---

<BaseLayout
  title={inspiration.data.title}
  description={inspiration.data.description}
  showSidebar={false}
  wideContent={true}
  bodyClass="body--daily"
  shellClass="page-shell--daily"
  panelClass="content-panel--daily"
  searchType="IDEA"
  searchSection="灵感"
>
  <article>
    <a class="post-backlink" href={withBasePath(getInspirationThemeHref(inspiration.data.theme))}>
      ← 返回 {inspiration.data.theme}
    </a>

    <header class="post-header">
      <h1>{inspiration.data.title}</h1>
      <div class="post-meta">
        <span>发布于：{formatDate(inspiration.data.date)}</span>
        <span>最后更新：{formatDate(updated)}</span>
        <span>{inspiration.data.theme}</span>
      </div>
    </header>

    <div class="prose prose--inspiration">
      <Content />
    </div>

    {sources.length > 0 && (
      <section class="content-sources" aria-labelledby="idea-sources-title">
        <h2 id="idea-sources-title">Source</h2>
        <ul>
          {sources.map((source) => (
            <li>
              {/^https?:\/\//i.test(source)
                ? <a href={source} target="_blank" rel="noopener noreferrer">{source}</a>
                : <span>{source}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <RelatedContent
      title="Related Writing"
      eyebrow="WRITING"
      items={relatedWriting.map((entry) => ({ href: withBasePath(getPostHref(entry)), title: entry.data.title, description: entry.data.description, meta: entry.data.category }))}
    />
  </article>
</BaseLayout>
