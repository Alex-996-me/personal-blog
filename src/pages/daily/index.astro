---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getAllInspirations, getInspirationAnchorId, getInspirationUpdatedDate } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

const inspirations = await getAllInspirations();
const renderedInspirations = await Promise.all(inspirations.map(async (inspiration) => {
  const { Content } = await render(inspiration);
  const updated = getInspirationUpdatedDate(inspiration);
  return { inspiration, Content, updated, hasUpdated: updated.valueOf() !== inspiration.data.date.valueOf() };
}));
---

<BaseLayout title="灵感" description="一些还没有长成文章的想法。" wideContent={true} bodyClass="body--daily" shellClass="page-shell--daily" panelClass="content-panel--daily">
  <header class="editorial-page-header daily-notebook__header">
    <a class="post-backlink" href={withBasePath("/")}>← 返回首页</a>
    <h1>灵感</h1>
    <p>一些还没有长成文章的想法。</p>
    <button type="button" class="daily-notebook__random" data-random-idea>随机一条 →</button>
  </header>
  <main class="daily-explained" aria-label="灵感">
    {renderedInspirations.map(({ inspiration, Content, updated, hasUpdated }) => (
      <article id={getInspirationAnchorId(inspiration)} class="daily-explained__item" data-daily-idea>
        <div class="daily-explained__meta"><time datetime={inspiration.data.date.toISOString()}>{formatDate(inspiration.data.date)}</time>{hasUpdated && <time datetime={updated.toISOString()}>更新 {formatDate(updated)}</time>}</div>
        <div class="daily-explained__content"><h2>{inspiration.data.title}</h2><div class="prose prose--inspiration"><Content /></div></div>
      </article>
    ))}
  </main>
  <script is:inline>
    (() => {
      const button = document.querySelector("[data-random-idea]");
      const ideas = [...document.querySelectorAll("[data-daily-idea]")];
      if (!button || ideas.length < 2) return;
      button.addEventListener("click", () => {
        const target = ideas[Math.floor(Math.random() * ideas.length)];
        target.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
        history.replaceState(null, "", `#${target.id}`);
      });
    })();
  </script>
</BaseLayout>
