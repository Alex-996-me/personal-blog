---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../data/site";
import {
  formatDate,
  getAllInspirations,
  getInspirationAnchorId,
  getInspirationUpdatedDate,
} from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

const inspirations = await getAllInspirations();
const renderedInspirations = await Promise.all(
  inspirations.map(async (inspiration) => {
    const { Content } = await render(inspiration);
    const updated = getInspirationUpdatedDate(inspiration);

    return {
      inspiration,
      Content,
      updated,
      hasUpdated: updated.valueOf() !== inspiration.data.date.valueOf(),
    };
  }),
);
---

<BaseLayout
  title="explained"
  description="explained"
  showSidebar={false}
  wideContent={true}
  bodyClass="body--daily"
  shellClass="page-shell--daily"
  panelClass="content-panel--daily"
>
  <section class="page-header page-header--daily-flip">
    <a class="post-backlink" href={withBasePath("/")}>← 返回首页</a>
    <h1>explained</h1>
  </section>

  {renderedInspirations.length > 0 && (
    <section class="daily-explained" aria-label="explained">
      {renderedInspirations.map(({ inspiration, Content, updated, hasUpdated }, index) => (
        <article id={getInspirationAnchorId(inspiration)} class="daily-explained__item">
          <div class="daily-explained__meta">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <time datetime={inspiration.data.date.toISOString()}>{formatDate(inspiration.data.date)}</time>
            {hasUpdated && <time datetime={updated.toISOString()}>更新 {formatDate(updated)}</time>}
          </div>
          <div class="daily-explained__content">
            <div class="daily-explained__identity">
              <span class="daily-flip-page__avatar" aria-hidden="true">{siteConfig.author.avatarLabel}</span>
              <span>{siteConfig.author.name}</span>
              <span>{siteConfig.author.handle}</span>
            </div>
            <h2>{inspiration.data.title}</h2>
            <div class="prose prose--inspiration">
              <Content />
            </div>
          </div>
        </article>
      ))}
    </section>
  )}
</BaseLayout>
