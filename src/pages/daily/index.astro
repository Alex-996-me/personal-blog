---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { inspirationThemes } from "../../data/site";
import { formatDate, getAllInspirations, getInspirationAnchorId, getInspirationUpdatedDate } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

const inspirations = await getAllInspirations();
const renderedInspirations = await Promise.all(inspirations.map(async (inspiration) => {
  const { Content } = await render(inspiration);
  const updated = getInspirationUpdatedDate(inspiration);
  return { inspiration, Content, updated, hasUpdated: updated.valueOf() !== inspiration.data.date.valueOf() };
}));
---

<BaseLayout title="灵感" description="IDEAS，explained by N=1 Lab。" showSidebar={false} wideContent={true} bodyClass="body--daily" shellClass="page-shell--daily" panelClass="content-panel--daily">
  <header class="daily-notebook__header">
    <a class="post-backlink" href={withBasePath("/")}>← 返回首页</a>
    <div class="daily-notebook__title-row">
      <div>
        <p>IDEAS</p>
        <h1>灵感</h1>
        <p class="daily-notebook__subtitle">explained by N=1 Lab · {renderedInspirations.length} notes</p>
      </div>
      <button type="button" class="daily-notebook__random" data-random-idea>Random idea ↗</button>
    </div>
    <div class="daily-theme-filter" role="group" aria-label="按主题筛选灵感">
      <button type="button" data-theme-filter="ALL" aria-pressed="true">ALL</button>
      {inspirationThemes.map((theme) => (
        <button type="button" data-theme-filter={theme.name} aria-pressed="false">{theme.name}</button>
      ))}
    </div>
  </header>

  {renderedInspirations.length > 0 && (
    <main class="daily-explained" aria-label="explained">
      {renderedInspirations.map(({ inspiration, Content, updated, hasUpdated }, index) => (
        <article id={getInspirationAnchorId(inspiration)} class="daily-explained__item" data-daily-idea data-theme={inspiration.data.theme}>
          <div class="daily-explained__meta">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <time datetime={inspiration.data.date.toISOString()}>{formatDate(inspiration.data.date)}</time>
            {hasUpdated && <time datetime={updated.toISOString()}>更新 {formatDate(updated)}</time>}
          </div>
          <div class="daily-explained__content">
            <h2>{inspiration.data.title}</h2>
            <div class="prose prose--inspiration"><Content /></div>
          </div>
        </article>
      ))}
    </main>
  )}

  <script is:inline>
    (() => {
      const button = document.querySelector("[data-random-idea]");
      const ideas = [...document.querySelectorAll("[data-daily-idea]")];
      const filters = [...document.querySelectorAll("[data-theme-filter]")];
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const visibleIdeas = () => ideas.filter((idea) => !idea.hidden);
      const applyFilter = (theme) => {
        filters.forEach((filter) => filter.setAttribute("aria-pressed", String(filter.dataset.themeFilter === theme)));
        ideas.forEach((idea) => { idea.hidden = theme !== "ALL" && idea.dataset.theme !== theme; });
      };
      filters.forEach((filter) => filter.addEventListener("click", () => applyFilter(filter.dataset.themeFilter || "ALL")));
      if (!button || ideas.length < 2) return;
      button.addEventListener("click", () => {
        const candidates = visibleIdeas();
        if (candidates.length === 0) return;
        const visibleIndex = candidates.findIndex((idea) => {
          const rect = idea.getBoundingClientRect();
          return rect.top <= window.innerHeight * 0.45 && rect.bottom >= window.innerHeight * 0.45;
        });
        let next = Math.floor(Math.random() * candidates.length);
        if (candidates.length > 1 && next === visibleIndex) next = (next + 1) % candidates.length;
        const target = candidates[next];
        target.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
        history.replaceState(null, "", `#${target.id}`);
      });
    })();
  </script>
</BaseLayout>
