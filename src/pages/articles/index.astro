---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleVisual from "../../components/ArticleVisual.astro";
import { getAllPosts, getUpdatedDate } from "../../lib/blog";
const posts = (await getAllPosts()).sort((a, b) => getUpdatedDate(b).valueOf() - getUpdatedDate(a).valueOf());
---
<BaseLayout title="文章" description="经过选择的判断、经验与长期思考。" wideContent={true} bodyClass="body--archive">
  <header class="editorial-page-header"><h1>文章</h1></header>
  <div class="essay-index">{posts.map((post) => <ArticleVisual post={post} heading="h2" />)}</div>
</BaseLayout>
