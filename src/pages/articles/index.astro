---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import PostCard from "../../components/PostCard.astro";
import { topicMatrix } from "../../data/site";
import { formatDate, getAllPosts, getCategoryCounts, getPostHref, getSelectedPosts, getUpdatedDate } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

const posts = await getAllPosts();
const selectedPosts = getSelectedPosts(posts);
const categoryCounts = getCategoryCounts(posts);
const topics = topicMatrix
  .map((topic) => ({
    ...topic,
    count: categoryCounts.find((category) => category.slug === topic.slug)?.count ?? 0,
  }));
---

<BaseLayout title="文章" description="N=1 Lab 的长文、实验记录与主题文章。" wideContent={true} bodyClass="body--archive" shellClass="page-shell--archive" panelClass="content-panel--archive">
  <section class="page-header page-header--archive">
    <a class="post-backlink" href={withBasePath("/")}>← 返回首页</a>
    <p class="page-header__eyebrow">WRITING / ARCHIVE</p>
    <h1>文章</h1>
  </section>

  <CategoryGrid topics={topics} />

  {selectedPosts.length > 0 && (
    <section class="selected-writing" aria-labelledby="selected-writing-title">
      <header>
        <p>SELECTED</p>
        <h2 id="selected-writing-title">Start Here</h2>
      </header>
      <ol>
        {selectedPosts.map((post, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3><a href={withBasePath(getPostHref(post))}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <small>{post.data.category} · {formatDate(getUpdatedDate(post))}</small>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="articles-index__latest" aria-labelledby="latest-writing-title">
    <h2 id="latest-writing-title">Latest Writing</h2>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
