---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import PostCard from "../../components/PostCard.astro";
import { topicMatrix } from "../../data/site";
import { getAllPosts, getCategoryCounts } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

const posts = await getAllPosts();
const categoryCounts = getCategoryCounts(posts);
const topics = topicMatrix
  .filter((topic) => topic.slug !== "resources")
  .map((topic) => ({
    ...topic,
    count: categoryCounts.find((category) => category.slug === topic.slug)?.count ?? 0,
  }));
---

<BaseLayout title="文章" description="N=1 Lab 的长文、实验记录与主题文章。" wideContent={true} bodyClass="body--archive" shellClass="page-shell--archive" panelClass="content-panel--archive">
  <section class="page-header page-header--archive">
    <a class="post-backlink" href={withBasePath("/")}>← 返回首页</a>
    <p class="page-header__eyebrow">WRITING / ARCHIVE</p>
    <h1>文章</h1>
  </section>

  <CategoryGrid topics={topics} />

  <section class="articles-index__latest" aria-labelledby="latest-writing-title">
    <h2 id="latest-writing-title">最近更新</h2>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
