---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleVisual from "../../components/ArticleVisual.astro";
import { getAllPosts, getSeriesGroups } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";
export async function getStaticPaths() { return getSeriesGroups(await getAllPosts()).map((series) => ({ params: { slug: series.slug }, props: { series } })); }
const { series } = Astro.props;
const yearGroups = Object.entries(Object.groupBy(series.posts, (post) => String(post.data.date.getFullYear()))).sort(([a], [b]) => Number(b) - Number(a));
---

<BaseLayout title={`${series.name} · N=1 Lab`} absoluteTitle={true} description={`${series.name}系列文章。`} wideContent={true} bodyClass="body--archive body--series" shellClass="page-shell--archive" panelClass="content-panel--archive">
  <article class="series-page"><header class="editorial-page-header"><a class="post-backlink" href={withBasePath("/articles/")}>← 返回文章</a><h1>{series.name}</h1></header>
    <div class="writing-archive">{yearGroups.map(([year, posts]) => <section class="writing-year"><h2>{year}</h2><div class="writing-year__entries">{posts?.map((post) => <ArticleVisual post={post} variant="row" compact={true} />)}</div></section>)}</div>
  </article>
</BaseLayout>
