---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LifePhoto from "../../components/LifePhoto.astro";
import { getAllMoments, getMomentDate, getMomentLocation, getMomentSlug, stripMarkdownToText, type Moment } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";
import "../../styles/moments.css";
export async function getStaticPaths() {
  return (await getAllMoments()).map((moment) => ({ params: { slug: getMomentSlug(moment) }, props: { moment } }));
}
const { moment } = Astro.props as { moment: Moment };
const { Content } = await render(moment);
const location = getMomentLocation(moment);
const date = getMomentDate(moment).toISOString().slice(0, 10);
const items = moment.data.items.length ? moment.data.items : moment.data.images.map((image) => ({ image, title: "", description: "" }));
const description = moment.data.description.trim();
const showLead = Boolean(description) && !stripMarkdownToText(moment.body ?? "").startsWith(description);
---
<BaseLayout title={moment.data.title || date} description={description} wideContent={true}
  bodyClass="body--moments body--moment-detail" shellClass="page-shell--moments"
  searchType="MOMENT" searchSection={location?.city ?? "生活"} searchDate={date}>
  <article class="moment-story">
    <div class="moment-gallery">
      {items.map((item, index) => (
        <figure>
          <LifePhoto src={item.image} alt={item.title || item.description || moment.data.title || ""} eager={index === 0} />
          {(item.title || item.description) && <figcaption>{item.title && <strong>{item.title}</strong>}{item.description && <span>{item.description}</span>}</figcaption>}
        </figure>
      ))}
    </div>
    <div class="moment-story__text">
      {moment.data.title && <h1>{moment.data.title}</h1>}
      {showLead && <p class="moment-story__lead">{description}</p>}
      {moment.body?.trim() && <div class="prose"><Content /></div>}
      <p class="moment-story__meta"><time datetime={date}>{date.replaceAll("-", ".")}</time>{location && <span>{location.city} · {location.country}</span>}{moment.data.place && <span>{moment.data.place}</span>}</p>
      <nav class="content-ending" aria-label="生活导航" data-pagefind-ignore><a href={withBasePath("/moments/")}>所有生活记录</a></nav>
    </div>
  </article>
</BaseLayout>
