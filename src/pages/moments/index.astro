---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllMoments, getMomentHref } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

const moments = (await getAllMoments()).filter((moment) => moment.data.location);

type CityGroup = {
  city: string;
  country: string;
  latitude: number;
  longitude: number;
  moments: typeof moments;
};

const cityGroups = [...moments.reduce((groups, moment) => {
  const location = moment.data.location!;
  const existing = groups.get(location.city);

  if (existing) {
    existing.moments.push(moment);
  } else {
    groups.set(location.city, {
      city: location.city,
      country: location.country,
      latitude: location.latitude,
      longitude: location.longitude,
      moments: [moment],
    });
  }

  return groups;
}, new Map<string, CityGroup>()).values()].sort((left, right) => left.city.localeCompare(right.city, "zh-CN"));

const cityOffsets: Record<string, { x: number; y: number }> = {
  "上海": { x: -112, y: 26 },
  "南京": { x: 38, y: 44 },
  "大连": { x: 38, y: -58 },
  "营口": { x: -138, y: -92 },
  "郑州": { x: -188, y: 6 },
  "东京": { x: 40, y: -34 },
  "莱斯特": { x: -148, y: -52 },
  "伦敦": { x: 32, y: 14 },
  "剑桥": { x: 52, y: 66 },
};

function cityId(city: string) {
  return `city-${encodeURIComponent(city).replace(/%/g, "")}`;
}

const worldBounds = {
  minLatitude: -85.60903777459771,
  maxLatitude: 83.64513000000001,
};

function mapPosition(latitude: number, longitude: number) {
  return {
    left: ((longitude + 180) / 360) * 100,
    top: ((worldBounds.maxLatitude - latitude) / (worldBounds.maxLatitude - worldBounds.minLatitude)) * 100,
  };
}

function primaryImage(moment: (typeof moments)[number]) {
  return moment.data.items[0]?.image ?? moment.data.images[0] ?? "";
}

---

<BaseLayout
  title="生活记录"
  description="按地点收藏的生活记录与美食照片。"
  showSidebar={false}
  wideContent={true}
  bodyClass="body--moments"
  shellClass="page-shell--moments"
  panelClass="content-panel--moments"
>
  <section class="moments-map-page">
    <header class="moments-map-page__header">
      <a class="post-backlink" href={withBasePath("/")}>← 返回首页</a>
      <h1>生活记录</h1>
      <span>{cityGroups.length} 个地点</span>
    </header>

    <div class="moments-map" data-moments-map data-world-map-source={withBasePath("/data-countries-110m.json")}>
      <div class="moments-map__toolbar" aria-label="地图控制">
        <button type="button" data-map-action="zoom-in" aria-label="放大地图">+</button>
        <button type="button" data-map-action="zoom-out" aria-label="缩小地图">−</button>
        <button type="button" data-map-action="reset" aria-label="重置地图视图">⌂</button>
      </div>

      <div class="moments-map__viewport" data-map-viewport>
        <div class="moments-map__canvas" data-map-canvas>
          <svg class="moments-map__land" viewBox="0 0 1000 500" role="img" aria-label="世界地图">
            <title>World map</title>
          </svg>

          {cityGroups.map((group) => {
            const position = mapPosition(group.latitude, group.longitude);
            const offset = cityOffsets[group.city] ?? { x: 20, y: 20 };
            const featured = group.moments.find((moment) => primaryImage(moment)) ?? group.moments[0];
            const image = primaryImage(featured);
            const panelId = cityId(group.city);

            return (
              <button
                type="button"
                class="moments-map__pin"
                data-city-trigger={panelId}
                data-city-name={group.city}
                aria-controls={panelId}
                aria-expanded="false"
                style={`--pin-left: ${position.left}%; --pin-top: ${position.top}%; --pin-offset-x: ${offset.x}px; --pin-offset-y: ${offset.y}px;`}
              >
                <span class="moments-map__pin-dot" aria-hidden="true"></span>
                <span class="moments-map__pin-card">
                  {image ? <img src={withBasePath(image)} alt="" loading="lazy" decoding="async" /> : <span class="moments-map__pin-empty">餐</span>}
                  <span>
                    <strong>{group.city}</strong>
                    <small>{featured.data.title}</small>
                  </span>
                </span>
              </button>
            );
          })}
        </div>
      </div>

      {cityGroups.map((group) => {
        const panelId = cityId(group.city);
        return (
          <section class="moments-map__city-panel" id={panelId} data-city-panel={panelId} hidden role="dialog" aria-modal="false">
            <div class="moments-map__city-header">
              <div>
                <p>{group.country}</p>
                <h2>{group.city}</h2>
              </div>
              <button type="button" data-city-close aria-label={`关闭 ${group.city} 的记录`}>×</button>
            </div>
            <div class="moments-map__city-grid">
              {group.moments.map((moment) => {
                const image = primaryImage(moment);
                return (
                  <a class="moments-map__restaurant-card" href={withBasePath(getMomentHref(moment))}>
                    {image ? <img src={withBasePath(image)} alt={moment.data.title} loading="lazy" decoding="async" /> : <div class="moments-map__food-placeholder">{moment.data.title}</div>}
                    <span>
                      <strong>{moment.data.title}</strong>
                      {moment.data.description && <small>{moment.data.description}</small>}
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}

    </div>
  </section>
</BaseLayout>

<script>
  const map = document.querySelector<HTMLElement>("[data-moments-map]");
  const viewport = map?.querySelector<HTMLElement>("[data-map-viewport]");
  const canvas = map?.querySelector<HTMLElement>("[data-map-canvas]");
  const worldMap = map?.querySelector<SVGSVGElement>(".moments-map__land");
  const triggers = [...(map?.querySelectorAll<HTMLButtonElement>("[data-city-trigger]") ?? [])];
  const panels = [...(map?.querySelectorAll<HTMLElement>("[data-city-panel]") ?? [])];
  const detailPanel = map?.querySelector<HTMLElement>("[data-moment-detail]");
  const detailImage = map?.querySelector<HTMLImageElement>("[data-moment-detail-image]");
  const detailTitle = map?.querySelector<HTMLElement>("[data-moment-detail-title]");
  const detailParent = map?.querySelector<HTMLElement>("[data-moment-detail-parent]");
  const detailDescription = map?.querySelector<HTMLElement>("[data-moment-detail-description]");

  const renderWorldMap = async () => {
    const source = map?.dataset.worldMapSource;
    if (!worldMap || !source) return;

    try {
      const response = await fetch(source);
      if (!response.ok) throw new Error("Unable to load map data");
      const topology = await response.json();
      const transform = topology.transform;
      const arcCache = new Map<number, Array<[number, number]>>();

      const resolveArc = (index: number) => {
        const normalizedIndex = index < 0 ? ~index : index;
        const cached = arcCache.get(normalizedIndex);
        let points = cached;

        if (!points) {
          let x = 0;
          let y = 0;
          points = topology.arcs[normalizedIndex].map(([dx, dy]: [number, number]) => {
            x += dx;
            y += dy;
            const longitude = x * transform.scale[0] + transform.translate[0];
            const latitude = y * transform.scale[1] + transform.translate[1];
            return [
              ((longitude + 180) / 360) * 1000,
              ((90 - latitude) / 180) * 500,
            ] as [number, number];
          });
          arcCache.set(normalizedIndex, points);
        }

        return index < 0 ? [...points].reverse() : points;
      };

      const ringPath = (ring: number[]) => {
        const points = ring.flatMap((arcIndex, arcNumber) => {
          const arc = resolveArc(arcIndex);
          return arcNumber === 0 ? arc : arc.slice(1);
        });
        return points.length
          ? `M${points.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join("L")}Z`
          : "";
      };

      topology.objects.countries.geometries.forEach((country: { type: string; arcs: number[][] | number[][][] }) => {
        const polygons = country.type === "Polygon" ? [country.arcs] : country.arcs;
        const d = (polygons as number[][][]).flatMap((polygon) => polygon.map(ringPath)).join("");
        if (!d) return;
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("class", "moments-map__country");
        path.setAttribute("d", d);
        worldMap.append(path);
      });
    } catch {
      map?.classList.add("moments-map--fallback");
    }
  };

  void renderWorldMap();

  if (map && viewport && canvas) {
    let scale = 1;
    let offsetX = 0;
    let offsetY = 0;
    let pointerId: number | null = null;
    let startX = 0;
    let startY = 0;
    let startOffsetX = 0;
    let startOffsetY = 0;

    const render = () => {
      canvas.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
    };

    const closeMomentDetail = () => {
      if (!detailPanel) return;
      detailPanel.hidden = true;
      detailPanel.setAttribute("aria-hidden", "true");
    };

    const closePanels = () => {
      closeMomentDetail();
      panels.forEach((panel) => {
        panel.hidden = true;
        panel.setAttribute("aria-hidden", "true");
      });
      triggers.forEach((trigger) => { trigger.setAttribute("aria-expanded", "false"); });
    };

    const setScale = (nextScale: number) => {
      scale = Math.min(1.85, Math.max(0.8, nextScale));
      render();
    };

    viewport.addEventListener("pointerdown", (event) => {
      if ((event.target as HTMLElement).closest("button")) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      startOffsetX = offsetX;
      startOffsetY = offsetY;
      viewport.setPointerCapture(pointerId);
      viewport.classList.add("is-dragging");
    });

    viewport.addEventListener("pointermove", (event) => {
      if (pointerId !== event.pointerId) return;
      offsetX = startOffsetX + event.clientX - startX;
      offsetY = startOffsetY + event.clientY - startY;
      render();
    });

    const stopDragging = (event: PointerEvent) => {
      if (pointerId !== event.pointerId) return;
      pointerId = null;
      viewport.classList.remove("is-dragging");
    };

    viewport.addEventListener("pointerup", stopDragging);
    viewport.addEventListener("pointercancel", stopDragging);
    viewport.addEventListener("wheel", (event) => {
      event.preventDefault();
      setScale(scale + (event.deltaY < 0 ? 0.12 : -0.12));
    }, { passive: false });

    map.querySelectorAll<HTMLButtonElement>("[data-map-action]").forEach((button) => {
      button.addEventListener("click", () => {
        const action = button.dataset.mapAction;
        if (action === "zoom-in") setScale(scale + 0.16);
        if (action === "zoom-out") setScale(scale - 0.16);
        if (action === "reset") {
          scale = 1;
          offsetX = 0;
          offsetY = 0;
          render();
          closePanels();
        }
      });
    });

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const id = trigger.dataset.cityTrigger;
        const panel = panels.find((item) => item.dataset.cityPanel === id);
        const shouldOpen = panel?.hidden;
        closePanels();
        if (panel && shouldOpen) {
          panel.hidden = false;
          panel.setAttribute("aria-hidden", "false");
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });

    map.querySelectorAll<HTMLButtonElement>("[data-city-close]").forEach((button) => {
      button.addEventListener("pointerdown", (event) => event.stopPropagation());
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        closePanels();
      });
    });

    map.querySelectorAll<HTMLButtonElement>("[data-moment-detail-trigger]").forEach((button) => {
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        if (!detailPanel) return;

        const image = button.dataset.momentImage ?? "";
        const title = button.dataset.momentTitle ?? "";
        const parent = button.dataset.momentParent ?? "";
        const description = button.dataset.momentDescription ?? "";

        if (detailImage) {
          detailImage.hidden = !image;
          detailImage.src = image;
          detailImage.alt = title;
        }
        if (detailTitle) detailTitle.textContent = title;
        if (detailParent) {
          detailParent.textContent = parent && parent !== title ? parent : "";
          detailParent.hidden = !detailParent.textContent;
        }
        if (detailDescription) {
          detailDescription.textContent = description;
          detailDescription.hidden = !description;
        }

        detailPanel.hidden = false;
        detailPanel.setAttribute("aria-hidden", "false");
      });
    });

    map.querySelectorAll<HTMLButtonElement>("[data-moment-detail-close]").forEach((button) => {
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        closeMomentDetail();
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closePanels();
    });
  }
</script>
