---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LifePhoto from "../../components/LifePhoto.astro";
import { getAllMoments, getMomentDate, getMomentHref, getMomentLocation } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";
import "../../styles/moments.css";
const moments = (await getAllMoments()).sort((a, b) => getMomentDate(b).valueOf() - getMomentDate(a).valueOf());
---
<BaseLayout title="生活" description="想留下来的地方、食物和日常。" wideContent={true} bodyClass="body--moments" shellClass="page-shell--moments">
  <div class="moments-journal">
    <header class="editorial-page-header"><h1>生活</h1><p>想留下来的地方、食物和日常。</p></header>
    <div class="moments-chronology">
      {moments.map((moment, index) => {
        const image = moment.data.items[0]?.image ?? moment.data.images[0];
        const date = getMomentDate(moment).toISOString().slice(0, 10);
        const location = getMomentLocation(moment);
        return <article class="moment-entry">
          <a href={withBasePath(getMomentHref(moment))} aria-label={moment.data.title || `${date} 的照片`}>
            {image && <div class="moment-entry__media"><LifePhoto src={image} alt="" eager={index === 0} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1008px) calc((100vw - 80px) / 2), 464px" /></div>}
            <div class="moment-entry__copy">
              {moment.data.title && <h2>{moment.data.title}</h2>}
              <p><time datetime={date}>{date.replaceAll("-", ".")}</time>{location?.city && <span>{location.city}</span>}{moment.data.place && <span>{moment.data.place}</span>}</p>
            </div>
          </a>
        </article>;
      })}
    </div>
  </div>
</BaseLayout>
