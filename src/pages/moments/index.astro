---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllMoments } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

const moments = (await getAllMoments()).filter((moment) => moment.data.location);

type CityGroup = {
  city: string;
  country: string;
  latitude: number;
  longitude: number;
  moments: typeof moments;
};

const cityGroups = [...moments.reduce((groups, moment) => {
  const location = moment.data.location!;
  const existing = groups.get(location.city);

  if (existing) {
    existing.moments.push(moment);
  } else {
    groups.set(location.city, {
      city: location.city,
      country: location.country,
      latitude: location.latitude,
      longitude: location.longitude,
      moments: [moment],
    });
  }

  return groups;
}, new Map<string, CityGroup>()).values()].sort((left, right) => left.city.localeCompare(right.city, "zh-CN"));

const cityOffsets: Record<string, { x: number; y: number }> = {
  "上海": { x: -112, y: 26 },
  "南京": { x: 38, y: 44 },
  "大连": { x: 38, y: -58 },
  "营口": { x: -138, y: -92 },
  "郑州": { x: -188, y: 6 },
  "东京": { x: 40, y: -34 },
  "莱斯特": { x: -148, y: -52 },
  "伦敦": { x: 32, y: 14 },
  "剑桥": { x: 52, y: 66 },
};

function cityId(city: string) {
  return `city-${encodeURIComponent(city).replace(/%/g, "")}`;
}

function mapPosition(latitude: number, longitude: number) {
  return {
    left: ((longitude + 180) / 360) * 100,
    top: ((90 - latitude) / 180) * 100,
  };
}

function primaryImage(moment: (typeof moments)[number]) {
  return moment.data.items[0]?.image ?? moment.data.images[0] ?? "";
}
---

<BaseLayout
  title="生活记录"
  description="按地点收藏的生活记录与美食照片。"
  showSidebar={false}
  wideContent={true}
  bodyClass="body--moments"
  shellClass="page-shell--moments"
  panelClass="content-panel--moments"
>
  <section class="moments-map-page">
    <header class="moments-map-page__header">
      <a class="post-backlink" href={withBasePath("/")}>← 返回首页</a>
      <h1>生活记录</h1>
      <span>{cityGroups.length} 个地点</span>
    </header>

    <div class="moments-map" data-moments-map>
      <div class="moments-map__toolbar" aria-label="地图控制">
        <button type="button" data-map-action="zoom-in" aria-label="放大地图">+</button>
        <button type="button" data-map-action="zoom-out" aria-label="缩小地图">−</button>
        <button type="button" data-map-action="reset" aria-label="重置地图视图">⌂</button>
      </div>

      <div class="moments-map__viewport" data-map-viewport>
        <div class="moments-map__canvas" data-map-canvas>
          <svg class="moments-map__land" viewBox="0 0 1000 500" role="img" aria-label="世界地图">
            <path d="M84 99l45-32 80 8 29 24-19 20-31 7-8 31-33 13-11 29-36-7-17-31 16-32-15-20z" />
            <path d="M242 175l34 18 17 45 27 33-8 47-28 52-13 55-28-21-13-61 12-40-19-38 7-40z" />
            <path d="M410 81l52-18 49 9 30-17 64 18 22 30-14 24-37 8-10 27-39 2-21 24-41-8-19-34-28-8 4-36z" />
            <path d="M472 182l49 2 34 31 11 55-22 55-28 51-34 6-23-58-9-65 22-48z" />
            <path d="M602 109l76-13 61 18 59-10 58 30-8 23-52 6-25 24-43-3-32 20-39-18-21-31-43-15z" />
            <path d="M700 192l44 8 19 33-18 20-36-15-22-27z" />
            <path d="M808 319l46 5 41 31-15 35-47 4-34-37z" />
            <path d="M903 420l25 7 18 21-27 8-29-14z" />
          </svg>

          {cityGroups.map((group) => {
            const position = mapPosition(group.latitude, group.longitude);
            const offset = cityOffsets[group.city] ?? { x: 20, y: 20 };
            const featured = group.moments.find((moment) => primaryImage(moment)) ?? group.moments[0];
            const image = primaryImage(featured);
            const panelId = cityId(group.city);

            return (
              <button
                type="button"
                class="moments-map__pin"
                data-city-trigger={panelId}
                aria-controls={panelId}
                aria-expanded="false"
                style={`--pin-left: ${position.left}%; --pin-top: ${position.top}%; --pin-offset-x: ${offset.x}px; --pin-offset-y: ${offset.y}px;`}
              >
                <span class="moments-map__pin-dot" aria-hidden="true"></span>
                <span class="moments-map__pin-card">
                  {image ? <img src={withBasePath(image)} alt="" loading="lazy" decoding="async" /> : <span class="moments-map__pin-empty">餐</span>}
                  <span>
                    <strong>{group.city}</strong>
                    <small>{featured.data.title}</small>
                  </span>
                </span>
              </button>
            );
          })}
        </div>
      </div>

      {cityGroups.map((group) => {
        const panelId = cityId(group.city);
        return (
          <section class="moments-map__city-panel" id={panelId} data-city-panel={panelId} hidden>
            <div class="moments-map__city-header">
              <div>
                <p>{group.country}</p>
                <h2>{group.city}</h2>
              </div>
              <button type="button" data-city-close aria-label={`关闭 ${group.city} 的记录`}>×</button>
            </div>
            <div class="moments-map__city-grid">
              {group.moments.map((moment) => {
                const image = primaryImage(moment);
                return (
                  <article class="moments-map__food-card">
                    {image ? <img src={withBasePath(image)} alt={moment.data.title} loading="lazy" decoding="async" /> : <div class="moments-map__food-placeholder">{moment.data.title}</div>}
                    <h3>{moment.data.title}</h3>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>

<script>
  const map = document.querySelector<HTMLElement>("[data-moments-map]");
  const viewport = map?.querySelector<HTMLElement>("[data-map-viewport]");
  const canvas = map?.querySelector<HTMLElement>("[data-map-canvas]");
  const triggers = [...(map?.querySelectorAll<HTMLButtonElement>("[data-city-trigger]") ?? [])];
  const panels = [...(map?.querySelectorAll<HTMLElement>("[data-city-panel]") ?? [])];

  if (map && viewport && canvas) {
    let scale = 1;
    let offsetX = 0;
    let offsetY = 0;
    let pointerId: number | null = null;
    let startX = 0;
    let startY = 0;
    let startOffsetX = 0;
    let startOffsetY = 0;

    const render = () => {
      canvas.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
    };

    const closePanels = () => {
      panels.forEach((panel) => { panel.hidden = true; });
      triggers.forEach((trigger) => { trigger.setAttribute("aria-expanded", "false"); });
    };

    const setScale = (nextScale: number) => {
      scale = Math.min(1.85, Math.max(0.8, nextScale));
      render();
    };

    viewport.addEventListener("pointerdown", (event) => {
      if ((event.target as HTMLElement).closest("button")) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      startOffsetX = offsetX;
      startOffsetY = offsetY;
      viewport.setPointerCapture(pointerId);
      viewport.classList.add("is-dragging");
    });

    viewport.addEventListener("pointermove", (event) => {
      if (pointerId !== event.pointerId) return;
      offsetX = startOffsetX + event.clientX - startX;
      offsetY = startOffsetY + event.clientY - startY;
      render();
    });

    const stopDragging = (event: PointerEvent) => {
      if (pointerId !== event.pointerId) return;
      pointerId = null;
      viewport.classList.remove("is-dragging");
    };

    viewport.addEventListener("pointerup", stopDragging);
    viewport.addEventListener("pointercancel", stopDragging);
    viewport.addEventListener("wheel", (event) => {
      event.preventDefault();
      setScale(scale + (event.deltaY < 0 ? 0.12 : -0.12));
    }, { passive: false });

    map.querySelectorAll<HTMLButtonElement>("[data-map-action]").forEach((button) => {
      button.addEventListener("click", () => {
        const action = button.dataset.mapAction;
        if (action === "zoom-in") setScale(scale + 0.16);
        if (action === "zoom-out") setScale(scale - 0.16);
        if (action === "reset") {
          scale = 1;
          offsetX = 0;
          offsetY = 0;
          render();
          closePanels();
        }
      });
    });

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const id = trigger.dataset.cityTrigger;
        const panel = panels.find((item) => item.dataset.cityPanel === id);
        const shouldOpen = panel?.hidden;
        closePanels();
        if (panel && shouldOpen) {
          panel.hidden = false;
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });

    map.querySelectorAll<HTMLButtonElement>("[data-city-close]").forEach((button) => {
      button.addEventListener("click", closePanels);
    });
  }
</script>
