---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleVisual from "../../components/ArticleVisual.astro";
import { categories } from "../../data/site";
import { getAllPosts, getCategoryBySlug, getUpdatedDate } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

export async function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug } })); }
const category = getCategoryBySlug(Astro.params.slug ?? "");
if (!category) throw new Error(`Unknown category slug: ${Astro.params.slug}`);
const filteredPosts = (await getAllPosts()).filter((post) => post.data.category === category.name);
const yearGroups = Object.entries(Object.groupBy(filteredPosts, (post) => String(getUpdatedDate(post).getFullYear()))).sort(([a], [b]) => Number(b) - Number(a));
---

<BaseLayout title={category.name} description={category.description} wideContent={true} bodyClass="body--archive" shellClass="page-shell--archive" panelClass="content-panel--archive">
  <header class="editorial-page-header"><a class="post-backlink" href={withBasePath("/articles/")}>← 返回文章</a><h1>{category.name}</h1><p>{category.description}</p></header>
  <div class="writing-archive">
    {yearGroups.map(([year, posts]) => <section class="writing-year"><h2>{year}</h2><div class="writing-year__entries">{posts?.map((post) => <ArticleVisual post={post} variant="row" />)}</div></section>)}
  </div>
</BaseLayout>
