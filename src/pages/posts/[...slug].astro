---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts, getPostSlug, getSources, getUpdatedDate, getYoutubeEmbedUrl } from "../../lib/blog";
import { withBasePath } from "../../lib/paths";
import "../../styles/essay-reading.css";

export async function getStaticPaths() {
  return (await getAllPosts()).map((post) => ({ params: { slug: getPostSlug(post) }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.date.toISOString().slice(0, 10);
const updated = getUpdatedDate(post).toISOString().slice(0, 10);
const sameDate = published === updated;
const sources = getSources(post.data.source).map((text) => ({ text, isLink: /^https?:\/\//i.test(text) }));
const youtubeEmbedUrl = getYoutubeEmbedUrl(post.data.youtube);
---
<BaseLayout title={post.data.title} description={post.data.description} ogImage={post.data.cover}
  bodyClass="body--post" searchType="ARTICLE" searchSection={post.data.category} searchDate={updated}>
  <article class="essay">
    <header class="post-header">
      <p class="post-header__eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="post-header__description">{post.data.description}</p>
      <div class="post-meta">
        <span>{sameDate ? "发布 / 更新" : "发布"} · <time datetime={published} itemprop="datePublished">{published.replaceAll("-", ".")}</time></span>
        <span class:list={[sameDate && "sr-only"]}>更新 · <time datetime={updated} itemprop="dateModified">{updated.replaceAll("-", ".")}</time></span>
      </div>
    </header>
    {youtubeEmbedUrl && <div class="video-embed"><iframe src={youtubeEmbedUrl} title={`${post.data.title} YouTube 视频`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>}
    <div class="reading-progress" data-reading-progress aria-hidden="true" hidden></div>
    <div class="essay-reading" data-essay-reading>
      <div class="prose" data-essay-body><Content /></div>
    </div>
    {sources.length > 0 && (
      <section class="content-sources" aria-labelledby="content-sources-title">
        <h2 id="content-sources-title">参考</h2>
        <ul>{sources.map((source) => <li>{source.isLink ? <a href={source.text} target="_blank" rel="noopener noreferrer">{source.text}</a> : <span>{source.text}</span>}</li>)}</ul>
      </section>
    )}
    <nav class="content-ending" aria-label="文章导航" data-pagefind-ignore><a href={withBasePath("/articles/")}>所有文章</a></nav>
  </article>
</BaseLayout>
<script>
  import "../../scripts/essay-reading";
</script>
