---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import {
  formatDate,
  getAllInspirations,
  getAllPosts,
  getCategoryHref,
  getInspirationDetailHref,
  getPostSlug,
  getPostHref,
  getSources,
  getUpdatedDate,
  getYoutubeEmbedUrl,
  resolveRelatedInspirations,
  resolveRelatedPosts,
} from "../../lib/blog";
import { withBasePath } from "../../lib/paths";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const youtubeEmbedUrl = getYoutubeEmbedUrl(post.data.youtube);
const updated = getUpdatedDate(post);
const categoryHref = withBasePath(getCategoryHref(post.data.category));
const isTrainingPost = post.data.category === "训练";
const [allPosts, allInspirations] = await Promise.all([getAllPosts(), getAllInspirations()]);
const relatedPosts = resolveRelatedPosts(post.data.relatedPosts, allPosts).filter((entry) => getPostSlug(entry) !== getPostSlug(post));
const relatedIdeas = resolveRelatedInspirations(post.data.relatedNotes, allInspirations);
const sources = getSources(post.data.source);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.cover}
  bodyClass={["body--post", isTrainingPost && "body--post-training"].filter(Boolean).join(" ")}
  shellClass={isTrainingPost ? "page-shell--post-training" : ""}
  panelClass={isTrainingPost ? "content-panel--post-training" : ""}
  searchType="ARTICLE"
  searchSection={post.data.category}
>
  <article>
    <a class="post-backlink" href={categoryHref}>← 返回{post.data.category}</a>

    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span>发布于：{formatDate(post.data.date)}</span>
        <span>最后更新：{formatDate(updated)}</span>
        <a href={categoryHref}>{post.data.category}</a>
      </div>
      {post.data.tags.length > 0 && (
        <div class="tag-list" aria-label="标签">
          {post.data.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    {youtubeEmbedUrl && (
      <div class="video-embed">
        <iframe
          src={youtubeEmbedUrl}
          title={`${post.data.title} YouTube 视频`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {sources.length > 0 && (
      <section class="content-sources" aria-labelledby="content-sources-title">
        <h2 id="content-sources-title">Source</h2>
        <ul>
          {sources.map((source) => (
            <li>
              {/^https?:\/\//i.test(source)
                ? <a href={source} target="_blank" rel="noopener noreferrer">{source}</a>
                : <span>{source}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <RelatedContent
      title="Related Ideas"
      eyebrow="IDEAS"
      items={relatedIdeas.map((idea) => ({ href: withBasePath(getInspirationDetailHref(idea)), title: idea.data.title, description: idea.data.description, meta: "IDEA" }))}
    />
    <RelatedContent
      title="Related Writing"
      eyebrow="WRITING"
      items={relatedPosts.map((entry) => ({ href: withBasePath(getPostHref(entry)), title: entry.data.title, description: entry.data.description, meta: entry.data.category }))}
    />
  </article>
</BaseLayout>
