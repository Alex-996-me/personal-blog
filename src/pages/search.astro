---
import { withBasePath } from "../lib/paths";
const home = withBasePath("/");
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>搜索入口已移至页头 | N=1 Lab</title>
    <link rel="canonical" href={new URL(home, Astro.site)} />
    <script is:inline define:vars={{ home }}>
      location.replace(home + location.search + "#header-search-input");
    </script>
  </head>
  <body><p>搜索已移至页头。<a href={home + "#header-search-input"}>返回 N=1 Lab</a></p></body>
</html>
