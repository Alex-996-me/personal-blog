---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/site";
import { withBasePath } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  wideContent?: boolean;
  bodyClass?: string;
  shellClass?: string;
  panelClass?: string;
  headerSearch?: boolean;
  headerSearchQuery?: string;
  headerSearchPlaceholder?: string;
  searchType?: "ARTICLE" | "MOMENT";
  noindex?: boolean;
  searchSection?: string;
  searchDate?: string;
  absoluteTitle?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = siteConfig.defaultOgImage,
  wideContent = false,
  bodyClass = "",
  shellClass = "",
  panelClass = "",
  searchType,
  searchSection = "",
  searchDate = "",
  absoluteTitle = false,
  noindex = false,
} = Astro.props;

const pageTitle = absoluteTitle || title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(withBasePath(ogImage), site).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBasePath("/favicon.svg")} />
    <link rel="icon" href={withBasePath("/favicon.ico")} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {searchType && <meta data-pagefind-meta="type[content]" content={searchType} />}
    {searchSection && <meta data-pagefind-meta="section[content]" content={searchSection} />}
    {searchType && <meta data-pagefind-meta="title[content]" content={title} />}
    {searchType && <meta data-pagefind-meta="description[content]" content={description} />}
    {searchDate && <meta data-pagefind-meta="date[content]" content={searchDate} />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <Header />
    <div class:list={["page-shell", "page-shell--single", shellClass]}>
      <main id="main-content" tabindex="-1" class="content-column" data-pagefind-body={searchType ? true : undefined} data-pagefind-ignore={!searchType ? true : undefined}>
        <div class:list={["content-panel", wideContent && "content-panel--wide", panelClass]}>
          <slot />
        </div>
      </main>
    </div>
    <Footer />
  </body>
</html>
