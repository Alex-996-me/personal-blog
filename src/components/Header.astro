---
import { navigation, siteConfig } from "../data/site";
import { withBasePath } from "../lib/paths";
import HeaderSearch from "./HeaderSearch.astro";

const pathname = Astro.url.pathname;

function isActive(href: string) {
  const target = withBasePath(href);
  if (href === "/") {
    return pathname === target;
  }
  return pathname.startsWith(target);
}

---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={withBasePath("/")}>{siteConfig.title}</a>

    <div class="site-header__controls">
      <nav class="site-nav" aria-label="顶部导航">
        {navigation.map((item) => (
          <a href={withBasePath(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))}
      </nav>

      <HeaderSearch />
    </div>
  </div>
</header>
