---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: string; alt: string; eager?: boolean; sizes?: string; }
const { src, alt, eager = false, sizes = "(max-width: 760px) calc(100vw - 40px), 960px" } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>("../../public/images/moments/**/*.{webp,jpg,jpeg,png}");
const load = photos[`../../public${src}`];
if (!load) throw new Error(`Life photo must be a local image in public/images/moments: ${src}`);
const { default: photo } = await load();
const widths = [...new Set([480, 960, 1440].map((width) => Math.min(width, photo.width)))];
---
<Image src={photo} alt={alt} widths={widths} sizes={sizes} format="webp" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" />
