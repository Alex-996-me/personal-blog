---
type RelatedItem = {
  href: string;
  title: string;
  description?: string;
  meta?: string;
};

interface Props {
  items: RelatedItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="related-content" aria-labelledby="continue-reading-title">
    <h2 id="continue-reading-title">继续阅读</h2>
    <ol class="related-content__list">
      {items.slice(0, 3).map((item) => (
        <li><a href={item.href}><strong>{item.title}</strong>{item.meta && <span>{item.meta}</span>}</a></li>
      ))}
    </ol>
  </section>
)}
